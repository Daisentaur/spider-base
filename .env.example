# Copy this file to .env and fill in what you need.

# Telegram setup (5 minutes):
#   1. Message @BotFather on Telegram, send /newbot, follow prompts -> you get a token.
#   2. Send any message to your new bot.
#   3. Open https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates in a browser
#      and copy the "chat":{"id": ...} number.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 1 = invisible browser (server default), 0 = always show the window
HEADLESS=1

# default browser engine: firefox or chromium. A task can pin one with
# a `browser = "chromium"` class attribute (e.g. for sites that only
# behave on chrome). Each engine has its own profile - log in once per engine.
BROWSER=firefox

# Credentials for sites that expire sessions too fast for profile/ to help
# (ERPs, banks). Tasks read these with os.getenv() to re-login when needed.
# .env is gitignored - credentials live here, never in task files.
ERP_USER=
ERP_PASS=
